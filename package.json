{
  "name": "keno-audit",
  "version": "1.2.1",
  "description": "Provably fair audit — Duel.com Keno",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "test": "mocha && npm run verify",
    "test:full": "mocha && npm run simulate && npm run verify",
    "verify": "ts-node tests/verify.ts",
    "simulate": "ts-node src/simulate.ts",
    "mutate": "node scripts/mutate.mjs",
    "release-manifest": "node scripts/release-manifest.mjs",
    "check:site-verifier": "node scripts/check-site-verifier.mjs",
    "rtp-claim:write": "ts-node src/rtp-settings.ts",
    "live-config": "ts-node src/live-config.ts"
  },
  "devDependencies": {
    "@types/mocha": "^10",
    "@types/node": "^22",
    "chart.js": "4.4.7",
    "mocha": "^11",
    "ts-node": "^10",
    "typescript": "^5"
  }
}
